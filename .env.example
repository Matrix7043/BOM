# Copy to .env to override defaults. Every value below is the default.
APP_ENV=local
HOST_PORT=8000

# Logging. LOG_FORMAT: json (one object per line, for log shippers) or text (human-readable)
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional rotating log file in addition to stdout:
# LOG_FILE=/srv/storage/app.log

# Model. TRANSFORM: sqrt or log1p
SIGNIFICANCE_ALPHA=0.05
TRANSFORM=sqrt

# Uploads
MAX_UPLOAD_MB=5
MAX_CHANNELS=20
MIN_ROWS=15
